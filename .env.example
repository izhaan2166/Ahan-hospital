# Copy to .env.local and fill in. Never commit real values.

# Public site URL, used for canonical links, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (server-only). Leave blank to run the appointment form in demo mode,
# which validates requests but clearly states that nothing was stored.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Email each appointment request to your inbox through Resend (server-only).
# Create an API key at https://resend.com/api-keys. Without a verified domain,
# Resend only delivers to the email address you signed up to Resend with.
RESEND_API_KEY=
APPOINTMENT_NOTIFY_TO=
# Optional sender. Defaults to Resend's test sender onboarding@resend.dev.
APPOINTMENT_NOTIFY_FROM=

# Send Strict-Transport-Security. Set to true only on an HTTPS-only deployment.
ENABLE_HSTS=false
